[Unit]
Description=FalconFox DEV daemon (dev branch, development checkout)

[Service]
# The development twin of falconfox-daemon.service. Everything that would
# collide with the deployment is redirected: the instance name gives it its own
# state (sessions, transcripts, server.json) and config, and it has its own
# pinned port. Not XDG_STATE_HOME/XDG_CONFIG_HOME: sessions inherit this
# environment, and those would redirect every tool an agent runs.
Environment=FALCONFOX_INSTANCE=dev
Environment=FALCONFOX_DAEMON=1
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@HOME@/.local/state/falconfox-dev/bin:@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin
ExecStart=@REPO@/.venv/bin/falconfox daemon --foreground --port 9725
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
