# FalconFox Telegram bot environment (systemd EnvironmentFile format).
# Copy to ~/.config/falconfox/telegram.env and fill in both values.
#
# The forum is ONE supergroup with Topics enabled, holding every session as a
# topic. The bot must be an administrator there with "Manage Topics".
#
# To find the id: create the group, enable Topics, add the bot, say anything,
# and read `ignoring message from unconfigured chat <id>` from the bot log.
# Note that enabling Topics upgrades a plain group to a supergroup and CHANGES
# its chat id, so read the id after enabling Topics, not before.
FALCONFOX_TELEGRAM_TOKEN=
FALCONFOX_TELEGRAM_FORUM_CHAT_ID=
